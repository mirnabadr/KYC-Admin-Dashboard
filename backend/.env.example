# ========== BACKEND ENVIRONMENT VARIABLES ==========
# Copy from project root .env or set here when running the backend.

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/kyc_admin?retryWrites=true&w=majority&appName=Cluster0

# JWT secret for signing tokens (use a long random string in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-jwt-secret-change-in-production

# Server port
PORT=3001

# Node environment
NODE_ENV=development

# Cybrid API (OAuth 2.0) - Get credentials from https://app.sandbox.cybrid.app
# Sandbox (testing): https://api.sandbox.cybrid.app
# Production (live): https://api.cybrid.app
CYBRID_API_URL=https://api.sandbox.cybrid.app

# OAuth Credentials from Cybrid Partner Portal
# Generate at: https://app.sandbox.cybrid.app → Developers → Generate New Key
CYBRID_CLIENT_ID=your-client-id-here
CYBRID_CLIENT_SECRET=your-client-secret-here

# Legacy support (will use CLIENT_ID/SECRET if available)
CYBRID_API_KEY=
CYBRID_API_SECRET=

# CORS origin (frontend URL)
CORS_ORIGIN=http://localhost:5173
